{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(python:*)",
      "Bash(find:*)",
      "Bash(ls:*)",
      "Bash(rm:*)",
      "Bash(source:*)",
      "Bash(export:*)",
      "Bash(timeout 30 python:*)",
      "Bash(gtimeout:*)",
      "Bash(grep:*)",
      "Bash(git checkout:*)",
      "Bash(git add:*)"
    ],
    "deny": []
  }
}